# Vonage
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_APPLICATION_ID=your_vonage_application_id
VONAGE_PRIVATE_KEY_PATH=./keys/private.key
VONAGE_NUMBER=your_vonage_phone_number

# Vonage Callback URLs (paths - BASE_URL is prepended automatically)
VONAGE_MONITORING_CALLBACK=/monitoring-event
VONAGE_RECORDING_CALLBACK=/recording-event
VONAGE_BROADCAST_CALLBACK=/broadcast-event
VONAGE_COMPOSER_CALLBACK=/composer-event
VONAGE_CAPTIONS_CALLBACK=/captions-event
VONAGE_SIP_MONITORING_CALLBACK=/sip-monitoring-event

# Server
PORT=3039
BASE_URL=https://your-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# Web
VITE_API_URL=https://your-domain.com
VITE_VONAGE_API_KEY=your_vonage_api_key
