# ─── Vonage Credentials ───────────────────────────────────────────────────────
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=7e59865f-d02d-441c-9409-0ed517fcebd7
VONAGE_NUMBER=

# Private key — use ONE of these:
# Option A (Railway/hosted): base64-encode your private key file:
#   cat private.key | base64 -w 0
#   Then paste the output as VONAGE_PRIVATE_KEY_B64
VONAGE_PRIVATE_KEY_B64=

# Option B (local dev): path to the key file
VONAGE_PRIVATE_KEY_PATH=./keys/private.key

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3039
BASE_URL=https://thbtechub.sbs
FRONTEND_URL=https://thbtechub.sbs

# ─── Vonage Video API Callback Verification Tokens ───────────────────────────
# These tokens verify that incoming callbacks are from Vonage.
# Copy them from your Vonage Dashboard > Video > Callback URLs.
VONAGE_MONITORING_TOKEN=_5TZiliad-_H33o5QjT3ZDM6lnYEmMVswhrkYATn3HY
VONAGE_RECORDING_TOKEN=sOdeJ-n4lBzxVwwnikUJmjHInnXozp-nqNEy0UTXnM4
